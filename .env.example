# Copy to .env.local for local development (never commit .env.local / .env.production).
# VITE_* values are inlined into the browser bundle at build time: never put a secret in one.

# Backend API base URL (required: a production build fails without it)
VITE_API_URL=http://localhost:8080/api/v1

# Public website origin, for "View live" links
# VITE_SITE_URL=http://localhost:3000

# "staging" on the staging Vercel project (shows the staging banner). Unset = production.
# VITE_APP_ENV=development
